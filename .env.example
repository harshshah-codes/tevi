# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- Database ---
DB_HOST=127.0.0.1
DB_NAME=house_of_virasat
DB_USER=root
DB_PASS=

# --- Admin panel (/admin) ---
# ADMIN_PASSWORD is hashed at boot. Leaving it unset falls back to a known
# default hash (admin / password), so set it before going live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Razorpay ---
# Placeholder keys keep the site in sandbox mode: no call ever reaches
# Razorpay, and orders are marked paid by the server's simulate endpoint.
# For real test-mode payments, put your rzp_test_* keys here and set
# RAZORPAY_SIMULATE=false. Swap to rzp_live_* only at launch.
RAZORPAY_KEY_ID=rzp_test_DUMMY_KEY_ID
RAZORPAY_KEY_SECRET=DUMMY_KEY_SECRET_REPLACE_ME
RAZORPAY_SIMULATE=true

# Shown to the customer in the Razorpay checkout window
RAZORPAY_NAME=House of Viraasat

# --- Shiprocket (courier pickup for shipped orders) ---
# While SHIPROCKET_SIMULATE is true the admin's "Request Delivery" button
# issues a local test AWB and sends nothing to Shiprocket. Add real
# credentials and set it to false to create real shipments.
SHIPROCKET_EMAIL=shiprocket@example.test
SHIPROCKET_API_TOKEN=DUMMY_SHIPROCKET_TOKEN
SHIPROCKET_SIMULATE=true
